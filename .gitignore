dmypy.json

# Pyre type checker
.pyre/

# Configuration files.
#
# src/config.yaml is per-machine state, not source: the settings window
# rewrites it on Save, so a tracked copy would leave every clone permanently
# modified and turn a pull into a conflict. Defaults live in
# src/config_schema.yaml instead, and a missing config file is not an error -
# the first run opens the settings window.
config.yaml

# Local working notes, session snapshots and config backups.
# Kept on disk, never published: they carry machine paths and the
# contents of assistant sessions, and a scheduled auto-commit task on
# this machine would otherwise sweep them into the repository.
_BRIEF-*.md
_СПРАВКА-*.md
config.yaml.backup-*
.claude-checkpoints/
ww_out.log
ww_err.log
ww_fault.log
*.log.1
support-info.txt

# exe build (tools/build-exe.ps1)
build-venv/
# the build recipe is ours, unlike the *.spec PyInstaller scatters
!tools/WhisperWriter.spec
